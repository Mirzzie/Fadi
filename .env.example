# CareerOS AI root environment template.
# Application runtime values live in apps/web/.env.example.

# Local PostgreSQL
DATABASE_URL=postgres://careeros:careeros@localhost:5433/careeros
DATABASE_DIRECT_URL=postgres://careeros:careeros@localhost:5433/careeros
POSTGRES_HOST_PORT=5433

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-strong-local-or-production-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
