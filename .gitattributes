# Normalize line endings so a Windows checkout doesn't rewrite files to CRLF and
# break tooling. Text is stored LF in the repo; Git handles the working-tree form.
* text=auto eol=lf

# Scripts and configs that must stay LF even on Windows.
*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
