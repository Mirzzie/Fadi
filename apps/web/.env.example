# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Generate production values with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-strong-local-or-production-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Local PostgreSQL
DATABASE_URL=postgres://careeros:careeros@localhost:5433/careeros

# Server-default AI provider — the fallback for users who haven't set their own
# (BYOK) key. Leave AI_PROVIDER unset to auto-pick the first key present below in
# order: Groq → Google → Anthropic → OpenAI. Set it explicitly to force one of
# "groq" | "google" | "anthropic" | "openai".
AI_PROVIDER=

# Groq (fast + free tier) — recommended server default. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier). https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic/Claude (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# External data sources
JOB_SOURCE_API_KEY=
NEWS_API_KEY=
