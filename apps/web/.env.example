# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Generate production values with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-strong-local-or-production-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Local PostgreSQL
DATABASE_URL=postgres://careeros:careeros@localhost:5433/careeros

# Server-default AI provider — the fallback for users who haven't set their own
# (BYOK) key. Leave AI_PROVIDER unset to auto-pick the first key present below in
# order: Groq → Google → Anthropic → OpenAI. Set it explicitly to force one of
# "groq" | "google" | "anthropic" | "openai".
AI_PROVIDER=

# Groq (fast + free tier) — recommended server default. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier). https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic/Claude (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Optional: Fadi's voice (speech in + out) ─────────────────────────────────
# All optional. Without any of these, Fadi falls back to the browser's built-in
# voice — which is silent on Linux (no system voices) and whose speech-to-text is
# disabled in Chromium. The self-hosted option below fixes both, $0 and private.
#
# SELF-HOSTED, local, keyless (recommended — works everywhere incl. Linux). Run two
# small OpenAI-compatible servers, then point Fadi at them:
#   TTS (Fadi speaks): docker run -d -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu
#   STT (Fadi hears):  docker run -d -p 8000:8000 fedirz/faster-whisper-server:latest-cpu
FADI_TTS_LOCAL_BASE=          # e.g. http://localhost:8880/v1
FADI_TTS_LOCAL_VOICE=am_michael
FADI_STT_LOCAL_BASE=          # e.g. http://localhost:8000/v1
FADI_STT_LOCAL_MODEL=Systran/faster-whisper-small.en
# (Alternatively, a Groq/OpenAI key above gives cloud neural voice with no extra
#  config; OPENAI_API_KEY also enables the real-time WebRTC voice below.)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=ash

# Fadi Job Scraper — Fadi's own browser-automation source (human-flow scraping of API-less
# sites), aggregated under the same job-search engine as the APIs. "1" to enable; needs
# Playwright + a browser installed (npx playwright install chromium). Off by default.
FADI_SCRAPER_ENABLED=

# External data sources — OPTIONAL. Job discovery + market intelligence work
# without these via keyless sources (GDELT, Hacker News, Remotive, BLS) + seed
# data; each key below just adds a richer provider. See env.server.ts / docs.
JOB_SOURCE_API_KEY=
NEWS_API_KEY=

# ── Optional: unlock more features ───────────────────────────────────────────
# Portfolio media upload (images/video). Without these, the portfolio works but
# the "upload media" button is disabled. Free Cloudinary account → an UNSIGNED
# upload preset. Only the public cloud name + preset are used (no secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Transactional email (password reset + email verification). Sign-up works
# WITHOUT these (verification isn't required); set them to actually send mail.
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM=

# Social sign-in buttons appear only when a provider's pair is set. Email/
# password login always works without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# More keyed data sources (all optional — providers self-report unavailable
# until set): ADZUNA_APP_ID/KEY, REED_API_KEY, JOOBLE_API_KEY,
# JSEARCH_RAPIDAPI_KEY, ONET_API_KEY, FRED_API_KEY, LIGHTCAST_CLIENT_ID/SECRET,
# APIFY_TOKEN. See docs/DATA_SOURCES_AND_REALTIME_INTELLIGENCE.md.
