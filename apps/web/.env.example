# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Generate production values with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-strong-local-or-production-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Local PostgreSQL
DATABASE_URL=postgres://careeros:careeros@localhost:5433/careeros

# Pluggable AI provider — "openai" | "anthropic" (default: openai)
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic/Claude (used when AI_PROVIDER=anthropic)
# Install @anthropic-ai/sdk and implement AnthropicProvider first
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# External data sources
JOB_SOURCE_API_KEY=
NEWS_API_KEY=
