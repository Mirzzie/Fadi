{
  "name": "careeros",
  "version": "0.1.0",
  "private": true,
  "description": "CareerOS AI MVP monorepo foundation.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @careeros/web run dev",
    "build": "npm --workspace @careeros/web run build",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:generate": "npm --workspace @careeros/database run db:generate",
    "db:migrate": "npm --workspace @careeros/database run db:migrate",
    "db:reset": "docker compose -f infrastructure/docker/docker-compose.yml down --volumes && docker compose -f infrastructure/docker/docker-compose.yml up -d postgres && npm run db:migrate",
    "db:seed:jobs": "npm --workspace @careeros/database run db:seed:jobs",
    "db:studio": "npm --workspace @careeros/database run db:studio",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d postgres",
    "lint": "npm --workspace @careeros/web run lint",
    "start": "npm --workspace @careeros/web run start",
    "typecheck": "npm --workspace @careeros/database run typecheck && npm --workspace @careeros/web run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
